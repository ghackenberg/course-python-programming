  <!-- Question 6: Except Order -->
  <question type="multichoice">
    <name>
      <text>Q06: Except Block Ordering</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>If you have both <code>except ValueError:</code> and <code>except Exception:</code>, which one should come first?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Specific exceptions (ValueError) must come before general ones (Exception). If <code>Exception</code> is first, it will catch everything, and the specific block will never run.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[ValueError first.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Correct.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Exception first.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It does not matter.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Python sorts them automatically.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect.</p>]]></text>
      </feedback>
    </answer>
  </question>

