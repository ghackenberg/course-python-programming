  <!-- Question 1: Complex Try Logic -->
  <question type="multichoice">
    <name>
      <text>Q01: Complex Try Logic</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Consider:</p>
<pre><code class="language-python">try:
    raise ValueError("Oops")
except ValueError:
    print("Caught")
    raise</code></pre>
<p>What happens?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>The ValueError is caught, "Caught" is printed, and then the bare <code>raise</code> re-raises the same exception, causing a crash (traceback) afterward.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Prints "Caught", then crashes with ValueError.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Correct.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Prints "Caught" and continues successfully.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. The raise keyword re-raises the error.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Crashes immediately without printing.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Syntax Error.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect.</p>]]></text>
      </feedback>
    </answer>
  </question>

  <!-- Question 2: Math.isclose -->
  <question type="multichoice">
    <name>
      <text>Q02: Floating Point Fix</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>How should you correctly compare two floats <code>a</code> and <code>b</code> for equality?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Use <code>math.isclose(a, b)</code> to handle small precision differences.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[math.isclose(a, b)]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Correct.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[a == b]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect (unsafe for floats).</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[a = b]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect (assignment).</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[round(a) == round(b)]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect (too imprecise).</p>]]></text>
      </feedback>
    </answer>
  </question>

