  <!-- Question 1: Basic Definition -->
  <question type="multichoice">
    <name>
      <text>Q01: Types of Errors - Definition</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Which type of error occurs <strong>before</strong> the code is executed, preventing Python from understanding the script?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Syntax errors occur during the parsing stage, before execution. Runtime errors happen during execution, and logical errors produce wrong results without crashing.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html">
      <text><![CDATA[<p>Correct!</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Your answer is partially correct.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>Your answer is incorrect.</p>]]></text>
    </incorrectfeedback>
    <answer fraction="100" format="html">
      <text><![CDATA[Syntax Error]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Correct. Syntax errors are grammatical mistakes caught before the program runs.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Runtime Error]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. Runtime errors happen while the program is running.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Logical Error]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. Logical errors occur when the program runs but does the wrong thing.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[System Error]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. This is not one of the three main Python error categories discussed.</p>]]></text>
      </feedback>
    </answer>
  </question>

