  <!-- Question 4: Logical Error - Operator Precedence -->
  <question type="multichoice">
    <name>
      <text>Logical Error - Precedence</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What is the result of <code>2 + 4 / 2</code>?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Division happens before addition. 4 / 2 is 2.0. Then 2 + 2.0 is 4.0.</p>]]></text>
    </generalfeedback>
