  <!-- Question 9: Raising vs Returning -->
  <question type="multichoice">
    <name>
      <text>Raising vs Returning Error Codes</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Why is raising an exception generally better than returning an error code (like -1)?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Exceptions force the caller to handle the problem or crash. Error codes can be ignored or accidentally used in calculations.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Exceptions cannot be ignored accidentally; error codes can.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Correct.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Exceptions use less memory.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Error codes are illegal in Python.]]></text>
