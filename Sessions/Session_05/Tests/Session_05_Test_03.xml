  <!-- Question 1: Try Execution Flow -->
  <question type="multichoice">
    <name>
      <text>Try-Except Flow (Exception)</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Consider the following code:</p>
<pre><code class="language-python">try:
    print("A")
    x = 1 / 0
    print("B")
except ZeroDivisionError:
    print("C")</code></pre>
<p>What is the output?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>It prints "A", then crashes at 1/0, jumping immediately to the except block, printing "C". "B" is never reached.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[A, C]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Correct.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A, B, C]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. It stops before B.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[A, B]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. It crashes before B.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[C]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. A is printed first.</p>]]></text>
      </feedback>
    </answer>
  </question>

