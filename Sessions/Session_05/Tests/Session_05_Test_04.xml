  <!-- Question 3: Logical Error - Loop -->
  <question type="multichoice">
    <name>
      <text>Logical Error - Loop</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What is wrong with this loop?</p>
<pre><code class="language-python">n = 5
while n > 0:
    print(n)
    n + 1</code></pre>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>The line <code>n + 1</code> calculates a value but doesn't assign it back to <code>n</code>. Thus, <code>n</code> remains 5, causing an infinite loop.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Infinite loop (n is not updated).]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Correct.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Syntax Error at n + 1.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. It's valid syntax (just useless).</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It prints 1 to 5.]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[It prints 5, 6, 7...]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrect. n stays 5.</p>]]></text>
      </feedback>
    </answer>
  </question>

