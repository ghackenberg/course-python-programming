  <!-- Question 6: pandas filtering -->
  <question type="multichoice">
    <name>
      <text>Q06: Pandas Boolean Indexing</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>How do you filter a DataFrame <code>df</code> to include only rows where the "Age" column is greater than 30?</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<code>df[df["Age"] > 30]</code>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<code>df.filter("Age" > 30)</code>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<code>df.where(df["Age"] > 30)</code>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<code>df["Age"] > 30</code>]]></text>
    </answer>
  </question>

