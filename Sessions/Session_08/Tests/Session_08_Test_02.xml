    <questiontext format="html"><text><![CDATA[<p>In a standard ascending Bubble Sort, when are two adjacent elements swapped?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>They are swapped if the left element is greater than the right element.</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[If the left element is greater than the right element.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[If the left element is smaller than the right element.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Only if both elements are equal to zero.]]></text></answer>
