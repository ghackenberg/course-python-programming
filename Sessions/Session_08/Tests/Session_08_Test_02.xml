    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[It must move closer to the base case.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[It must stay exactly the same.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[It must double in size.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[It must be converted to a different data type.]]></text></answer>
