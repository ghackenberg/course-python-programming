  <question type="multichoice">
    <name><text>Q01: Stack Operations</text></name>
    <questiontext format="html"><text><![CDATA[<p>Which operation allows you to view the top element of a stack without removing it?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Peek (or Top) allows viewing the top element without modification.</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[Peek]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Pop]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Push]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Enqueue]]></text></answer>
  </question>

