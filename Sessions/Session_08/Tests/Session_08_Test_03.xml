stack.append("C")
stack.pop()
print(stack[-1])</code></pre>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>1. ["A", "B", "C"]. 2. Pop "C" -> ["A", "B"]. 3. Peek -> "B".</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[B]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[C]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[A]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[IndexError]]></text></answer>
  </question>

