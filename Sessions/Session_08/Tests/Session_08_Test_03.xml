  <question type="multichoice">
    <name><text>Q10: Factorial recursive step</text></name>
    <questiontext format="html"><text><![CDATA[<p>Which line of code correctly represents the recursive step for calculating <code>factorial(n)</code>?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Factorial is n multiplied by the factorial of n-1.</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[<code>return n * factorial(n - 1)</code>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<code>return n + factorial(n - 1)</code>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<code>return factorial(n - 1)</code>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<code>return n * (n - 1)</code>]]></text></answer>
  </question>

