  <question type="multichoice">
    <name><text>Q06: Sorting: Bubble Sort "Bubbling"</text></name>
    <questiontext format="html"><text><![CDATA[<p>Why is Bubble Sort named "Bubble" Sort?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Because larger elements gradually "bubble up" to their correct position at the end of the list in each pass.</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[Because large elements move towards the end like bubbles rising in water.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Because it uses a circular data structure.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Because it only works for decimal numbers.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Because it shuffles the list randomly.]]></text></answer>
  </question>

  <question type="multichoice">
