    <generalfeedback format="html"><text><![CDATA[<p>1. ["Task 1", "Task 2", "Task 3"]. 2. popleft() removes "Task 1" -> ["Task 2", "Task 3"]. 3. q[0] is "Task 2".</p>]]></text></generalfeedback>
