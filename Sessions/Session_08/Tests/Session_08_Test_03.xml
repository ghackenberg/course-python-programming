q.popleft()
print(q[0])</code></pre>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>1. ["Task 1", "Task 2", "Task 3"]. 2. popleft() removes "Task 1" -> ["Task 2", "Task 3"]. 3. q[0] is "Task 2".</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[Task 2]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Task 1]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Task 3]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[deque(["Task 2", "Task 3"])]]></text></answer>
  </question>

