  <!-- 8.1 Stacks -->
  <question type="multichoice">
    <name><text>Q01: Stack Analogy Logic</text></name>
    <questiontext format="html"><text><![CDATA[<p>In a stack of plates in a cafeteria, which plate is the most accessible?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>The top plate is the only one that can be removed without disturbing the others (LIFO).</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[The one at the very top.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[The one at the very bottom.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[The one in the exact middle.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[All plates are equally accessible.]]></text></answer>
  </question>

  <question type="multichoice">
    <name><text>Q02: Efficient Stack Code Output</text></name>
    <questiontext format="html"><text><![CDATA[<p>What is the output of the following sequence?</p>
<pre><code>stack = []
