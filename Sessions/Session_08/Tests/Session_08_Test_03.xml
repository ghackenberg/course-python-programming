  <question type="multichoice">
    <name><text>Q03: Node Pointer Purpose</text></name>
    <questiontext format="html"><text><![CDATA[<p>In a Linked List node, what is the purpose of the <code>next</code> pointer?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>It stores the memory location of the following node in the chain.</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[To link the current node to the next node in sequence.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[To store the numeric value of the node.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[To point back to the head of the list.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[To store the name of the list.]]></text></answer>
  </question>

  <question type="multichoice">
    <name><text>Q04: Continuous Memory Advantage</text></name>
    <questiontext format="html"><text><![CDATA[<p>What is the primary benefit of storing array elements in a single, continuous block of memory?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>It allows the computer to jump directly to any element using its index (instant access).</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[Instant access to any element via its index.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Faster insertion at the beginning of the list.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Easier resizing without moving data.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[No need for index numbers.]]></text></answer>
  </question>

