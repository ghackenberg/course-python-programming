  <question type="multichoice">
    <name><text>Q09: Recursion: mystery function</text></name>
    <questiontext format="html"><text><![CDATA[<p>What is the output of <code>mystery(3)</code>?</p>
<pre><code>def mystery(n):
    if n == 0:
        return 0
    return n + mystery(n - 1)</code></pre>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>3 + mystery(2) = 3 + (2 + mystery(1)) = 3 + 2 + (1 + 0) = 6.</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[6]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[3]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[5]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[0]]></text></answer>
  </question>

  <question type="multichoice">
    <name><text>Q10: Recursive string reversal</text></name>
    <questiontext format="html"><text><![CDATA[<p>Consider the logic: "The reverse of a string is the reverse of the rest followed by the first character." What is the result of <code>rev("abc")</code>?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>rev("abc") = rev("bc") + "a" = (rev("c") + "b") + "a" = "c" + "b" + "a" = "cba".</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[cba]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[abc]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[acb]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[bac]]></text></answer>
  </question>

