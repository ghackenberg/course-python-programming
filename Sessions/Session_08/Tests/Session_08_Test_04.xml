  <question type="multichoice">
    <name><text>Q01: FIFO Principle</text></name>
    <questiontext format="html"><text><![CDATA[<p>In a FIFO structure, if you add A, B, and C in that order, which one is removed first?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>FIFO (First-In, First-Out) means the first item added (A) is the first to be removed.</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[A]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[B]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[C]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[None of them]]></text></answer>
  </question>

