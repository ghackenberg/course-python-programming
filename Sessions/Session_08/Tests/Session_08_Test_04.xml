  <!-- 8.1 Stacks -->
  <question type="multichoice">
    <name><text>Q01: Stack Memory Behavior</text></name>
    <questiontext format="html"><text><![CDATA[<p>What happens when a stack is full and you attempt to <strong>push</strong> another element?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Pushing onto a full stack results in a Stack Overflow.</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[Stack Overflow]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Stack Underflow]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Segmentation Fault]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[The stack automatically resizes.]]></text></answer>
  </question>

  <question type="multichoice">
    <name><text>Q02: Stack Code: Operation sequence</text></name>
    <questiontext format="html"><text><![CDATA[<p>What is the state of the stack after these operations?</p>
<pre><code>s = []
s.append(10)
s.append(20)
s.pop()
s.append(30)
s.append(40)
s.pop()</code></pre>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>1. [10]. 2. [10, 20]. 3. [10]. 4. [10, 30]. 5. [10, 30, 40]. 6. [10, 30].</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[[10, 30]]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[[10, 20, 30, 40]]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[[10, 40]]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[[20, 40]]]></text></answer>
  </question>

