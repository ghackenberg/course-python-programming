  <question type="multichoice">
    <name><text>Q03: Queue Performance</text></name>
    <questiontext format="html"><text><![CDATA[<p>Why is removing the first element of a standard Python list (<code>pop(0)</code>) slower than adding an element to the end (<code>append()</code>)?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>Removing the first element requires shifting all remaining elements to fill the empty space.</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[Because all other elements must be shifted left.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Because the list must be re-sorted.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Because lists can only grow in size.]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Because memory must be deleted manually.]]></text></answer>
  </question>

