  <question type="multichoice">
    <name><text>Q01: Stack vs Queue: Removal</text></name>
    <questiontext format="html"><text><![CDATA[<p>If you add elements to a structure and the <strong>most recently added</strong> element is the one removed next, which structure are you using?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>This is the LIFO (Last-In, First-Out) principle, which defines a Stack.</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[Stack]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Queue]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Linked List]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[Array]]></text></answer>
  </question>

