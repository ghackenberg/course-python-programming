  <question type="multichoice">
    <name><text>Q15: Recursive Factorial Definition</text></name>
    <questiontext format="html"><text><![CDATA[<p>Which is the correct recursive definition for <code>n!</code> (Factorial)?</p>]]></text></questiontext>
    <generalfeedback format="html"><text><![CDATA[<p>The factorial of n is defined as n multiplied by the factorial of n-1.</p>]]></text></generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answer fraction="100" format="html"><text><![CDATA[<code>n * (n - 1)!</code>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<code>n + (n - 1)!</code>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<code>(n - 1)! / n</code>]]></text></answer>
    <answer fraction="0" format="html"><text><![CDATA[<code>n! * n!</code>]]></text></answer>
  </question>
