    </name>
    <questiontext format="html">
      <text><![CDATA[<p>A component's length must be between 24.9mm and 25.1mm. Which condition correctly checks if a `measured_length` is within this valid range?</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text>`measured_length >= 24.9 and measured_length <= 25.1`</text>
    </answer>
    <answer fraction="0" format="html">
      <text>`measured_length > 24.9 or measured_length < 25.1`</text>
    </answer>
    <answer fraction="0" format="html">
      <text>`measured_length > 24.9 and measured_length < 25.1`</text>
    </answer>
    <answer fraction="0" format="html">
      <text>`measured_length == 24.9 and measured_length == 25.1`</text>
    </answer>
  </question>
  
