  <!-- Question 2: Simple - 'continue' statement -->
  <question type="multichoice">
    <name>
      <text>S02.2.9: 'continue' statement</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What does the <code>continue</code> statement do inside a loop?</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[It skips the rest of the current iteration and moves to the next one.]]></text>
