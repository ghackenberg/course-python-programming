  <!-- Question 6: Medium - List pop() method -->
  <question type="multichoice">
    <name>
      <text>S02.3.10: List pop method</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What is the main difference between <code>list.remove(value)</code> and <code>list.pop(index)</code>?</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<code>remove</code> searches for a value, while <code>pop</code> uses an index; <code>pop</code> also returns the removed item.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<code>remove</code> deletes an item from the end of the list, while <code>pop</code> deletes from the beginning.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[They are identical and can be used interchangeably.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<code>pop</code> can only remove the last item, while <code>remove</code> can remove any item.]]></text>
    </answer>
  </question>

