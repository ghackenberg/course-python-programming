  <!-- Question 8: Hard - Infinite loop -->
  <question type="multichoice">
    <name>
      <text>S02.2.6: Infinite loop cause</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Why does the following code result in an infinite loop?</p><pre><code>count = 0
while count < 5:
    print("Processing...")</code></pre>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[The variable <code>count</code> is never updated inside the loop, so the condition <code>count < 5</code> is always true.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The condition should be <code>count <= 5</code>.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[The <code>print</code> statement is causing the loop to reset.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<code>while</code> loops are always infinite.]]></text>
    </answer>
  </question>
  
