  <!-- Question 10: Hard - Tuple Unpacking -->
  <question type="multichoice">
    <name>
      <text>S02.4.2: Tuple Unpacking</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>A function <code>get_sensor_reading()</code> returns the tuple <code>(25.5, 60.1)</code>. Which line of code correctly unpacks this into <code>temp</code> and <code>humidity</code> variables?</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[<code>temp, humidity = get_sensor_reading()</code>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<code>(temp, humidity) = get_sensor_reading()</code>]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<code>temp = get_sensor_reading()[0]</code> and <code>humidity = get_sensor_reading()[1]</code> are the only ways.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[<code>get_sensor_reading(temp, humidity)</code>]]></text>
    </answer>
