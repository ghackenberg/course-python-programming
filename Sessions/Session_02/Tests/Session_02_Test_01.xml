  <!-- Question 6: List vs Tuple -->
  <question type="multichoice">
    <name>
      <text>S02.4.1: List vs Tuple Mutability</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>What is the primary difference between a list and a tuple in Python?</p>]]></text>
    </questiontext>
    <defaultgrade>1</defaultgrade>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <answer fraction="100" format="html">
      <text><![CDATA[Lists are mutable (changeable), while tuples are immutable (unchangeable).]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Tuples are mutable (changeable), while lists are immutable (unchangeable).]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Lists can only store items of the same data type, while tuples can store different types.]]></text>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Lists use parentheses <code>()</code> while tuples use square brackets <code>[]</code>.]]></text>
    </answer>
  </question>
  
